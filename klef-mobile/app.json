{
  "expo": {
    "name": "Paixi",
    "slug": "klef-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "klefmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.skyyti.klefmobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Permet de prendre des photos de vos logements, de vos pièces d'identité (CNI/Passeport) et des états des lieux.",
        "NSPhotoLibraryUsageDescription": "Permet de choisir des photos depuis votre galerie pour vos annonces, profil et états des lieux.",
        "NSPhotoLibraryAddUsageDescription": "Permet d'enregistrer vos reçus de réservation et vos baux de location dans votre galerie photos.",
        "NSLocationWhenInUseUsageDescription": "Permet de vous géolocaliser pour afficher les logements et séjours disponibles à proximité au Sénégal."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14654C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FBF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#041912",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-asset",
      "expo-video",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
